secrets/

# dotenv environment variable files
*.env
*.env.development
*.env.test
*.env.production
*.env*.local

# Vault
*vault/data/*
*!vault/data/.gitkeep
*vault/logs/*
*!vault/logs/.gitkeep

# Nestjs specific
srcs/stack/backend/dist
srcs/stack/backend/srcs
srcs/stack/backend/build
srcs/stack/backend/tmp
srcs/stack/backend/src/generated/prisma

# Nextjs specific
srcs/stack/frontend/.next/
srcs/stack/frontend/out/
srcs/stack/frontend/build
srcs/stack/frontend/coverage

# vercel
*.vercel

# dependencies
*node_modules
*.pnp
*.pnp.*
*.yarn/*
*!.yarn/patches
*!.yarn/plugins
*!.yarn/releases
*!.yarn/versions

# Logs
*logs
*.log
*npm-debug.log*
*pnpm-debug.log*
*yarn-debug.log*
*yarn-error.log*
*lerna-debug.log*


# temp directory
*.temp
*.tmp

# misc
.DS_Store
*.pem


# typescript
*.tsbuildinfo
*next-env.d.ts

# Tests (Nest)
*.nyc_output

# IDEs and editors
*/.idea
*.project
*.classpath
*.c9/
*.launch
*.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Runtime data
*pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
*report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json