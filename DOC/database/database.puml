rectangle Pets #DCEEFF [
<b>PETS</b>
|= id |= user_id |= name |= species |= bio |= photo |= created_at |
| <i>UUID</i> | <i>UUID</i> | <i>VARCHAR</i> | <i>VARCHAR</i> | <i>TEXT</i> | <i>VARCHAR</i> | <i>TIMESTAMP</i> |
